# SmartApt — Environment Variables
# Copy this file to .env.local and fill in your values

# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...   # JANGAN expose ke client!

# ── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
ADMIN_PASSWORD=ganti-dengan-password-aman

# ── WhatsApp Fonnte ───────────────────────────────────────────
FONNTE_TOKEN=token-dari-fonnte.com
FONNTE_RELAY_URL=https://your-worker.workers.dev   # Cloudflare Worker relay
RELAY_SECRET=random-string-rahasia

# ── Cron ──────────────────────────────────────────────────────
CRON_SECRET=random-string-untuk-auth-cron
